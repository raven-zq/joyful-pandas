export default {
  async fetch(req, env) {
    const url = new URL(req.url);
    if (url.pathname === "/") return new Response(HTML, {headers:{"Content-Type":"text/html;charset=UTF-8"}});
    if (url.pathname === "/api/chat") {
      try {
        const body = await req.json();
        const resp = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${env.GOOGLE_API_KEY}`, {
          method: "POST",
          headers: {"Content-Type":"application/json"},
          body: JSON.stringify({contents:[{parts:[{text:body.prompt}]}]})
        });
        
        const data = await resp.json();
        
        // 诊断逻辑：如果谷歌报错，直接把原样错误传回手机
        if (data.error) {
          return new Response(JSON.stringify({reply: "谷歌 API 报错: " + data.error.message}), {status: 200});
        }
        
        if (!data.candidates || data.candidates.length === 0) {
          return new Response(JSON.stringify({reply: "模型拒绝回答，可能是触发了安全审核。"}), {status: 200});
        }

        return new Response(JSON.stringify({reply: data.candidates[0].content.parts[0].text}));
      } catch (e) {
        return new Response(JSON.stringify({reply: "Worker 运行异常: " + e.message}));
      }
    }
    return new Response("Not Found", {status:404});
  }
};

const HTML = `<!DOCTYPE html><html><head><meta charset="UTF-8"><title>Yoda BI</title><script src="https://cdn.tailwindcss.com"></script></head><body class="bg-slate-50 h-screen flex flex-col p-4"><div id="c" class="flex-1 overflow-y-auto space-y-4 mb-4"></div><div class="flex gap-2"><input id="q" class="flex-1 p-3 rounded-xl border border-blue-200 outline-none focus:ring-2 focus:ring-blue-500" placeholder="问问数据迁移..."><button onclick="send()" id="b" class="bg-blue-600 text-white px-6 rounded-xl">发送</button></div><script>async function send(){const q=document.getElementById('q'),c=document.getElementById('c'),b=document.getElementById('b'),v=q.value;if(!v||b.disabled)return;q.value='';b.disabled=true;c.innerHTML+='<div class="p-3 bg-blue-600 text-white rounded-lg self-end ml-auto max-w-[80%]">'+v+'</div>';const l=document.createElement('div');l.className='p-3 bg-white border rounded-lg max-w-[80%]';l.innerText='思考中...';c.appendChild(l);try{const r=await fetch('/api/chat',{method:'POST',body:JSON.stringify({prompt:v})});const d=await r.json();l.innerText=d.reply;}catch(e){l.innerText='请求失败: '+e.message;}b.disabled=false;c.scrollTop=c.scrollHeight;}<\/script></body></html>`;
