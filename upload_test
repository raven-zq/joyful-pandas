export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // 1. 首页路由
    if (url.pathname === "/") {
      return new Response(HTML, {
        headers: { "Content-Type": "text/html;charset=UTF-8" }
      });
    }

    // 2. 聊天 API 路由
    if (url.pathname === "/api/chat") {
      try {
        const body = await request.json();
        const api_key = env.GOOGLE_API_KEY;
        const user_prompt = body.prompt;

        // 模型尝试列表：从最强到最稳
        const model_list = [
          "gemini-1.5-pro",
          "gemini-1.5-flash",
          "gemini-pro"
        ];

        let final_res = null;
        let used_model_name = "";

        // 自动循环尝试，直到有一个成功
        for (const model_id of model_list) {
          const target_url = `https://generativelanguage.googleapis.com/v1beta/models/${model_id}:generateContent?key=${api_key}`;
          
          const response = await fetch(target_url, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              contents: [{ parts: [{ text: user_prompt }] }]
            })
          });

          const result_data = await response.json();

          if (!result_data.error && result_data.candidates) {
            final_res = result_data.candidates[0].content.parts[0].text;
            used_model_name = model_id;
            break; // 成功获取结果，跳出循环
          }
        }

        if (final_res) {
          return new Response(JSON.stringify({
            reply: final_res,
            model: used_model_name
          }));
        } else {
          return new Response(JSON.stringify({
            reply: "所有模型均不可用，请检查 API Key 权限或区域。"
          }), { status: 500 });
        }

      } catch (err) {
        return new Response(JSON.stringify({
          reply: "Worker 运行异常: " + err.message
        }), { status: 500 });
      }
    }

    return new Response("Not Found", { status: 404 });
  }
};

// 界面部分
const HTML = `
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yoda BI Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-100 h-screen flex flex-col p-4">
    <div class="max-w-2xl mx-auto w-full flex flex-col h-full bg-white shadow-xl rounded-2xl overflow-hidden">
        <header class="bg-blue-600 text-white p-4 font-bold text-center">Yoda BI - 多模型自适应版</header>
        <div id="chat-box" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50 text-sm"></div>
        <div class="p-4 border-t flex gap-2">
            <input type="text" id="input" class="flex-1 border rounded-xl px-4 py-2 outline-none focus:ring-2 focus:ring-blue-500" placeholder="请输入指令...">
            <button onclick="send()" id="btn" class="bg-blue-600 text-white px-6 py-2 rounded-xl active:scale-95 transition-all">发送</button>
        </div>
    </div>

    <script>
        const chatBox = document.getElementById('chat-box');
        const input = document.getElementById('input');
        const btn = document.getElementById('btn');

        async function send() {
            const text = input.value.trim();
            if (!text || btn.disabled) return;

            input.value = '';
            btn.disabled = true;

            chatBox.innerHTML += '<div class="flex justify-end"><div class="bg-blue-600 text-white p-3 rounded-xl max-w-[85%]">' + text + '</div></div>';
            
            const loading = document.createElement('div');
            loading.innerHTML = '<div class="bg-white border p-3 rounded-xl max-w-[85%] text-gray-400 italic">正在匹配可用模型并思考...</div>';
            chatBox.appendChild(loading);
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: text })
                });
                const data = await res.json();
                loading.innerHTML = '<div class="bg-white border p-3 rounded-xl text-slate-700 shadow-sm">' + data.reply.replace(/\\n/g, '<br>') + '</div><div class="text-[10px] text-gray-400 mt-1 ml-1">响应模型: ' + (data.model || 'Unknown') + '</div>';
            } catch (e) {
                loading.innerHTML = '<div class="text-red-500 text-xs">请求失败，请检查网络。</div>';
            }
            
            btn.disabled = false;
            chatBox.scrollTop = chatBox.scrollHeight;
        }
        input.addEventListener('keypress', (e) => { if(e.key === 'Enter') send(); });
    </script>
</body>
</html>
`;