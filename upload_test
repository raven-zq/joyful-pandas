export default {
  async fetch(request, env) {
    const url = new URL(request.url);

    // 1. 首页：渲染聊天界面
    if (url.pathname === "/") {
      return new Response(HTML, {
        headers: { "Content-Type": "text/html;charset=UTF-8" }
      });
    }

    // 2. 接口：处理与 Gemini 的通信
    if (url.pathname === "/api/chat") {
      try {
        const body = await request.json();
        const apiSecret = env.GOOGLE_API_KEY;

        const response = await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-pro:generateContent?key=${apiSecret}`, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            contents: [{ parts: [{ text: body.prompt }] }]
          })
        });

        const data = await response.json();

        // 诊断逻辑：如果 API 返回报错（如 Key 错误）
        if (data.error) {
          return new Response(JSON.stringify({ reply: "API 报错: " + data.error.message }));
        }

        // 诊断逻辑：如果 API 返回为空（如安全过滤）
        if (!data.candidates || data.candidates.length === 0) {
          return new Response(JSON.stringify({ reply: "Gemini 拒绝回答（可能触发安全审核）" }));
        }

        const result = data.candidates[0].content.parts[0].text;
        return new Response(JSON.stringify({ reply: result }));

      } catch (err) {
        return new Response(JSON.stringify({ reply: "Worker 内部错误: " + err.message }));
      }
    }

    return new Response("Not Found", { status: 404 });
  }
};

// 简单的 UI 界面字符串
const HTML = `
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Yoda BI Assistant</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 h-screen flex flex-col p-4">
    <div class="max-w-2xl mx-auto w-full flex flex-col h-full bg-white shadow-lg rounded-xl overflow-hidden">
        <header class="bg-blue-600 text-white p-4 font-bold text-center">Yoda BI - Gemini 1.5 Pro</header>
        <div id="chat-box" class="flex-1 overflow-y-auto p-4 space-y-4 bg-gray-50"></div>
        <div class="p-4 border-t flex gap-2">
            <input type="text" id="input" class="flex-1 border rounded-lg px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500" placeholder="输入问题...">
            <button onclick="send()" id="btn" class="bg-blue-600 text-white px-4 py-2 rounded-lg hover:bg-blue-700 transition-colors">发送</button>
        </div>
    </div>

    <script>
        const chatBox = document.getElementById('chat-box');
        const input = document.getElementById('input');
        const btn = document.getElementById('btn');

        async function send() {
            const text = input.value.trim();
            if (!text || btn.disabled) return;

            input.value = '';
            btn.disabled = true;

            // 显示用户消息
            chatBox.innerHTML += \`<div class="flex justify-end"><div class="bg-blue-600 text-white p-3 rounded-lg max-w-[85%] shadow-sm">\${text}</div></div>\`;
            
            // 显示加载状态
            const loading = document.createElement('div');
            loading.className = 'flex justify-start';
            loading.innerHTML = '<div class="bg-white border p-3 rounded-lg max-w-[85%] shadow-sm text-gray-400">思考中...</div>';
            chatBox.appendChild(loading);
            chatBox.scrollTop = chatBox.scrollHeight;

            try {
                const res = await fetch('/api/chat', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ prompt: text })
                });
                const data = await res.json();
                loading.querySelector('div').innerText = data.reply;
                loading.querySelector('div').classList.remove('text-gray-400');
            } catch (e) {
                loading.querySelector('div').innerText = '请求失败，请检查网络或 API 设置';
                loading.querySelector('div').classList.add('text-red-500');
            }
            
            btn.disabled = false;
            chatBox.scrollTop = chatBox.scrollHeight;
        }

        input.addEventListener('keypress', (e) => { if(e.key === 'Enter') send(); });
    </script>
</body>
</html>
`;